{
  "name": "lekhira-writes",
  "productName": "Lekhira Writes",
  "version": "0.1.0",
  "description": "Lekhira Writes: the free web writing editor from Lekhira.",
  "author": "Lekhira",
  "license": "SEE LICENSE IN LICENSE.txt",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=server server/index.js",
    "test": "node --disable-warning=ExperimentalWarning test/run.js",
    "test:pg": "node --disable-warning=ExperimentalWarning test/postgres.js",
    "pages": "node pages/build.js"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@electric-sql/pglite-socket": "0.2.18"
  }
}
